# ==============================================================================
# Uzina Studio — Variáveis de Ambiente (Uso Local Zero-Config & VPS/Mobile)
# ==============================================================================
# MODO ZERO-CONFIG (PC Local):
#   Deixe DATABASE_URL vazia para rodar 100% local com PGlite + LibSQLStore.
#   Na primeira execução local, `uzina start` gera automaticamente
#   ${UZINA_DATA_DIR}/.master-key (0600) e BETTER_AUTH_SECRET se ausentes.
#
# MODO VPS / PRODUÇÃO / MOBILE (PWA + Voz + Web Push HTTPS):
#   Defina DATABASE_URL, MASTER_ENCRYPTION_KEY, BETTER_AUTH_SECRET,
#   BETTER_AUTH_URL, BETTER_AUTH_TRUSTED_ORIGINS e VAPID_SUBJECT.
#   Consulte docs/deploy-vps-mobile.md para detalhes de Caddy e proxies externos.
# ==============================================================================

NODE_ENV=development
PORT=3000

# Diretório local de dados (pgdata/, mastra.db, uploads/, .master-key, .vapid-keys.json)
# Compatibilidade legada: caso UZINA_DATA_DIR não esteja definida, o runtime pode ler FACTORY_DATA_DIR antes do fallback "./data".
UZINA_DATA_DIR=./data

# Persistência Dual-Mode (descomente para PostgreSQL + pgvector em 1 linha)
# DATABASE_URL=postgres://uzina:uzina@localhost:5432/uzina

# Banco opcional para validação live de PostgreSQL na suíte de testes
# TEST_DATABASE_URL=postgres://uzina:uzina@localhost:5432/uzina_test

# Chave mestra AES-256-GCM (32 bytes em hex — 64 caracteres). Obrigatória em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# Better Auth (obrigatório em produção/VPS)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Origens HTTPS confiáveis adicionais para Better Auth (separadas por vírgula, sem "*")
# Ex.: BETTER_AUTH_TRUSTED_ORIGINS=https://studio.seudominio.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Modo estrito de segredos ("1" ou "true" falha no boot em produção se faltar segredo explícito)
UZINA_STRICT_SECRETS=0

# Domínio usado pelo Caddy no docker-compose.vps.yml (HTTPS automático)
# UZINA_DOMAIN=studio.seudominio.com

# Web Push VAPID (se VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY ficarem vazias,
# o servidor gera e persiste automaticamente em ${UZINA_DATA_DIR}/.vapid-keys.json com permissão 0600)
VAPID_SUBJECT=mailto:admin@uzina.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bootstrap opcional do gateway OmniRoute (OpenAI-compatible) no cofre
OMNIROUTE_BASE_URL=http://localhost:8080/v1
OMNIROUTE_API_KEY=
