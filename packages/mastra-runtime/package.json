{
  "name": "@uzina/mastra-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c ../../eslint.config.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "1.85.0",
    "@mastra/libsql": "1.31.1",
    "@mastra/pg": "1.37.0",
    "@uzina/contracts": "workspace:*",
    "@uzina/core": "workspace:*",
    "@uzina/db": "workspace:*",
    "@uzina/opencode-bridge": "workspace:*",
    "@uzina/security-engine": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
