{
  "name": "@uzina/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "import": "./dist/state-machine.js"
    },
    "./stuck-detector": {
      "types": "./dist/stuck-detector.d.ts",
      "import": "./dist/stuck-detector.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    },
    "./strategy-router": {
      "types": "./dist/strategy-router.d.ts",
      "import": "./dist/strategy-router.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./design-md": {
      "types": "./dist/design-md.d.ts",
      "import": "./dist/design-md.js"
    },
    "./cost": {
      "types": "./dist/cost.d.ts",
      "import": "./dist/cost.js"
    },
    "./test-auditor": {
      "types": "./dist/test-auditor.d.ts",
      "import": "./dist/test-auditor.js"
    },
    "./qmd": {
      "types": "./dist/qmd.d.ts",
      "import": "./dist/qmd.js"
    },
    "./prototypes": {
      "types": "./dist/prototypes.d.ts",
      "import": "./dist/prototypes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c ../../eslint.config.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@uzina/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
